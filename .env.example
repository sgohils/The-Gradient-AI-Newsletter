# Optional: with no LLM key, summaries use the extractive fallback.
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional: newsletter contacts and email delivery.
RESEND_API_KEY=
MAILER_FROM_EMAIL=The Gradient <newsletter@example.com>
NEWSLETTER_BASE_URL=http://localhost:3000

OUTPUT_DIR=posts
# Optional image generation. Set to on and supply a Pixazo key to enable.
GRADIENT_IMAGE_GEN=off
PIXAZ_API_KEY=
GRADIENT_IMAGE_MODEL=flux

# Video rendering needs no publishing credentials. Setup: docs/video-pipeline.md
ZERNIO_API_KEY=
ZERNIO_YOUTUBE_ACCOUNT_ID=
ZERNIO_TIKTOK_ACCOUNT_ID=
# Local Python 3.11, FFmpeg, and ffprobe paths when not on PATH:
# VIDEO_PYTHON=
# VIDEO_FFMPEG=
# VIDEO_FFPROBE=
